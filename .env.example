# Copy to .env and fill in values. Never commit .env.

# AI — default OpenAI (required for live screening assistant)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional alternate provider (only if AI_PROVIDER=grok)
# GROK_API_KEY=
# GROK_MODEL=grok-4.3
# GROK_BASE_URL=https://api.x.ai/v1

JWT_SECRET=change-me-to-a-long-random-string
PORT=5000

# Optional legacy admin bootstrap
# ADMIN_EMAIL=admin@horailabs.com
# ADMIN_PASSWORD=Admin123!
