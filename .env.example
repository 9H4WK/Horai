# Copy to .env (or run: npm run setup)
# Never commit real .env files.

# Server
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string

# AI screening (OpenAI) — optional for first boot
# Without a key the app still runs; employer AI badge stays offline and
# screening falls back to profile-based heuristics.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional alternate provider (only if AI_PROVIDER=grok)
# GROK_API_KEY=
# GROK_MODEL=grok-4.3
# GROK_BASE_URL=https://api.x.ai/v1

# Optional admin bootstrap on empty DB
# ADMIN_EMAIL=admin@horailabs.com
# ADMIN_PASSWORD=Admin123!
